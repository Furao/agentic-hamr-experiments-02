{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamr.dev/schemas/assessment-summary-v1.schema.json",
  "title": "HAMR experiment assessment summary v1",
  "type": "object",
  "required": ["schema_version", "run", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "run": {
      "type": "object",
      "required": ["project", "session_id", "harness", "harness_version", "models", "profile"],
      "properties": {
        "project": {"type": "string"},
        "session_id": {"type": ["string", "null"]},
        "harness": {"enum": ["claude-code", "codex", null]},
        "harness_version": {"type": ["string", "null"]},
        "models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "profile": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "category", "severity", "scope", "title", "evidence", "recommendation_target", "evidence_limit"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "category": {"enum": [1, 2, 3, 4]},
          "severity": {"enum": ["blocker", "moderate", "minor", "positive"]},
          "scope": {"enum": ["hamr", "shared-workflow", "claude", "codex", "environment"]},
          "title": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "recommendation_target": {"type": "string", "minLength": 1},
          "evidence_limit": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
