-- Do not edit this file as it will be overwritten if HAMR codegen is rerun

ENUM
	OperatingMode: {Normal: 0, Recovery: 1};

INPUT
	api_error_status: bool;
	api_current_mode: OperatingMode;



PTSPEC
	hlr_30_llr_15_16_recovery_deadline: O[2,2](api_error_status && !(O[1,1](api_error_status))) -> O[0,1](api_current_mode == Recovery);


