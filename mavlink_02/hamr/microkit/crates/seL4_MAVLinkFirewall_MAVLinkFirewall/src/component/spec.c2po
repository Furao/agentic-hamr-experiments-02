-- Do not edit this file as it will be overwritten if HAMR codegen is rerun

ENUM
	OperatingMode: {Normal: 0, Recovery: 1};

INPUT
	in_rejected_count: int;
	fn_error_threshold: int;
	api_error_status: bool;
	api_current_mode: OperatingMode;


FTSPEC
	hlr_30_llr_15_16_recovery_deadline: (in_rejected_count < fn_error_threshold) &&
	    api_error_status ->
	    F[1,2](api_current_mode == Recovery);



